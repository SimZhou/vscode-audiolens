{
  "name": "audiolens",
  "displayName": "AudioLens",
  "description": "Audio preview and viewer with waveform inspection and spectrogram analysis for VS Code.",
  "version": "1.0.1",
  "publisher": "simzhou",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "logo/icon.png",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "qna": "marketplace",
  "extensionKind": [
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SimZhou/vscode-audiolens.git"
  },
  "bugs": {
    "url": "https://github.com/SimZhou/vscode-audiolens/issues"
  },
  "homepage": "https://github.com/SimZhou/vscode-audiolens#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "audio",
    "audio-preview",
    "audio-viewer",
    "audio-analysis",
    "waveform",
    "waveform-viewer",
    "spectrum",
    "spectrogram",
    "spectrogram-viewer",
    "speech",
    "rms",
    "dbfs",
    "fft",
    "stft",
    "custom-editor",
    "wav",
    "mp3",
    "flac",
    "ogg",
    "remote-ssh",
    "pcm",
    "raw-audio"
  ],
  "activationEvents": [
    "onCustomEditor:audiolens.audioPreview",
    "onCommand:audiolens.selectLanguage"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "audiolens.selectLanguage",
        "title": "AudioLens: 切换语言"
      }
    ],
    "customEditors": [
      {
        "viewType": "audiolens.audioPreview",
        "displayName": "AudioLens",
        "selector": [
          {
            "filenamePattern": "*.wav"
          },
          {
            "filenamePattern": "*.mp3"
          },
          {
            "filenamePattern": "*.flac"
          },
          {
            "filenamePattern": "*.ogg"
          },
          {
            "filenamePattern": "*.opus"
          },
          {
            "filenamePattern": "*.m4a"
          },
          {
            "filenamePattern": "*.aac"
          },
          {
            "filenamePattern": "*.pcm"
          },
          {
            "filenamePattern": "*.raw"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "AudioLens",
      "properties": {
        "audiolens.autoAnalyze": {
          "type": "boolean",
          "default": true,
          "description": "打开音频后自动计算频谱。"
        },
        "audiolens.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "zh-TW",
            "en",
            "ja",
            "ko",
            "fr",
            "de",
            "ru",
            "es",
            "it",
            "pt",
            "id",
            "no",
            "nl",
            "pl",
            "tr",
            "vi"
          ],
          "enumDescriptions": [
            "Use VS Code display language",
            "中文（简体）",
            "中文（繁體）",
            "English",
            "日本語",
            "한국어",
            "Français",
            "Deutsch",
            "Русский",
            "Español",
            "Italiano",
            "Português",
            "Bahasa Indonesia",
            "Norsk",
            "Nederlands",
            "Polski",
            "Türkçe",
            "Tiếng Việt"
          ],
          "default": "auto",
          "description": "Controls the AudioLens Webview language."
        },
        "audiolens.analysis.windowFunction": {
          "type": "string",
          "enum": [
            "rectangular",
            "bartlett",
            "hamming",
            "hann",
            "blackman",
            "blackmanHarris",
            "welch",
            "gaussian25",
            "gaussian35",
            "gaussian45"
          ],
          "default": "hamming",
          "description": "默认频谱窗函数。"
        },
        "audiolens.analysis.fftSize": {
          "type": "number",
          "enum": [
            8,
            16,
            32,
            64,
            128,
            256,
            512,
            1024,
            2048,
            4096,
            8192,
            16384,
            32768
          ],
          "default": 512,
          "description": "默认 FFT 长度。"
        },
        "audiolens.analysis.zeroPaddingFactor": {
          "type": "number",
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32,
            64,
            128
          ],
          "default": 2,
          "description": "默认频谱零填充因子。"
        },
        "audiolens.maxFileSizeMB": {
          "type": "number",
          "default": 512,
          "minimum": 16,
          "description": "Webview 解码前允许加载的最大音频文件大小。"
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "AudioLens 在不受信任工作区中只显示文件信息，不传输音频内容到 Webview。"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "rust:test": "cargo test --workspace",
    "package": "npm run clean && npm run build && npx @vscode/vsce package -o dist/audiolens-1.0.1.vsix",
    "vscode:prepublish": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
